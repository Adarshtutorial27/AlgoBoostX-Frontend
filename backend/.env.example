# ==============================================================================
# TokenIQ Algorithmic Trading System - Environment Configuration
# Delta Exchange Testnet Environment
# ==============================================================================

# Application Settings
APP_NAME=TokenIQ
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Delta Exchange Testnet Credentials
# Get your API keys at: https://testnet.delta.exchange
DELTA_API_KEY=your_testnet_api_key_here
DELTA_API_SECRET=your_testnet_api_secret_here
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL=wss://socket-ind.testnet.deltaex.org

# Operational Mode
# Set to 'true' to use live Delta Exchange Testnet, or 'false' for self-contained simulation/demo mode
USE_LIVE_TESTNET=false

# Trading Strategy Configuration (EMA Crossover)
DEFAULT_INSTRUMENT=BTCUSD
DEFAULT_TIMEFRAME=5m
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
CANDLE_LIMIT=100
MAX_DATA_AGE_SECONDS=300

# Risk Management Controls
MAX_ORDER_QTY=0.05
MAX_POSITION_EXPOSURE=0.20
MAX_OPEN_ORDERS=3
DAILY_LOSS_LIMIT=500.0
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
DEFAULT_ORDER_TYPE=market

# Execution Loop Settings
TRADING_LOOP_INTERVAL_SECONDS=10
ORDER_TIMEOUT_SECONDS=15
RECONCILE_INTERVAL_SECONDS=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./tokeniq.db
SYNC_DATABASE_URL=sqlite:///./tokeniq.db
