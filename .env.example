# ==============================================================================
# ALGOboostX — Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env and configure for your local/production environment.
# NEVER commit .env or exchange secrets to public or shared version control.
# ==============================================================================

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_DELTA_ENV=testnet
VITE_ENABLE_PAPER_MODE=true

# --- Backend Application Settings (FastAPI) ---
APP_NAME=AlgoBoostX
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Persistence ---
DATABASE_URL=sqlite:///./tokeniq.db

# --- Security & CORS Origins ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://algoboostx.app"]

# --- Exchange & Broker Settings (Delta Exchange Testnet) ---
# NOTE: Live trading is strictly disabled by default (Safety First: Paper Trading).
USE_LIVE_TESTNET=false
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=
DELTA_API_SECRET=
DEFAULT_INSTRUMENT=BTCUSD
DEFAULT_TIMEFRAME=5m

# --- Algorithmic Risk Management Engine ---
MAX_POSITION_SIZE_USD=500.0
MAX_DRAWDOWN_PERCENT=5.0
DAILY_LOSS_LIMIT_USD=100.0
MAX_CONCURRENT_ORDERS=3
EMERGENCY_STOP_ENABLED=false
